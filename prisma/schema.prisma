generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Modrik (مدرك) — evidence-based, human-in-the-loop
// agentic requirements engineering platform (MVP)
// ─────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────
// Identity foundation (H1.2)
// Users are authentication principals; stakeholders remain domain
// participants and must never be treated as login identities.
// ─────────────────────────────────────────────────────────────

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  passwordHash    String?
  displayName     String       @default("")
  status          String       @default("active") // active | disabled
  emailVerifiedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  memberships     Membership[]
  sessions        AuthSession[]
  projectsCreated Project[]    @relation("ProjectCreator")
  invitationsSent OrganizationInvitation[] @relation("InvitationSender")
  invitationsReceived OrganizationInvitation[] @relation("InvitationRecipient")
  organizationAuditEvents OrganizationAuditEvent[]
  passwordResetTokens PasswordResetToken[]

  @@index([status, createdAt])
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  status      String       @default("active") // active | suspended
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
  projects    Project[]
  invitations OrganizationInvitation[]
  auditEvents OrganizationAuditEvent[]

  @@index([status, createdAt])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("viewer") // owner | admin | engineer | reviewer | approver | viewer
  status         String       @default("invited") // invited | active | suspended | revoked
  invitedAt      DateTime     @default(now())
  activatedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sessions       AuthSession[]

  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}


model AuthSession {
  id             String     @id // signed token jti; raw bearer material is never stored
  userId         String
  membershipId   String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([userId, revokedAt, expiresAt])
  @@index([membershipId, revokedAt, expiresAt])
}

model Project {
  id           String   @id @default(cuid())
  name         String
  brief        String
  status       String   @default("active") // active | complete | archived
  currentStage String   @default("ELICITATION")
  stageStatus  String   @default("awaiting_input") // awaiting_input | agent_running | awaiting_review | approving | approved
  isDemo       Boolean  @default(false)
  // Nullable during the additive identity rollout. Existing projects remain
  // unassigned until an explicit, audited organization-ownership migration.
  organizationId String?
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdByUserId String?
  createdBy User? @relation("ProjectCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  evidenceOperations EvidenceOperation[]
  evidences  Evidence[]
  questions  Question[]
  candidates ProblemCandidate[]
  artifacts  Artifact[]
  runs       PipelineRun[]
  reqs       Requirement[]
  stories    UserStory[]
  conflicts  Conflict[]
  decisions  DecisionEntry[]
  plannerRuns PlannerRun[]
  edges      ReqEdge[]
  execScenarios ExecScenario[]
  syncMaps   SyncMap[]
  studySessions StudySession[]
  memories MemoryEntry[]
  integrations Integration[]
  traceLinks TraceLink[]
  evidenceClaims EvidenceClaim[]
  requirementClaims RequirementClaim[]
  knowledgeNodes KnowledgeNode[]
  knowledgeEdges KnowledgeEdge[]
  knowledgeNodeClaims KnowledgeNodeClaim[]
  knowledgeRequirements KnowledgeRequirement[]
  requirementQualityAssessments RequirementQualityAssessment[]
  stakeholders StakeholderProfile[]
  stakeholderPositions StakeholderPosition[]
  stakeholderPositionEvidence StakeholderPositionEvidence[]
  negotiationDecisions NegotiationDecision[]
  negotiationParticipants NegotiationParticipant[]

  @@index([organizationId, updatedAt])
  @@index([createdByUserId])
}

// Three-group between-subjects user study (dev item 14)
model StudySession {
  id             String   @id @default(cuid())
  projectId      String?  // group C sessions bind to a Modrik project
  project        Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  groupId        String   // A_traditional | B_unconstrained_llm | C_modrik
  participantCode String  // anonymised participant code (PDPL: no names)
  participantTokenHash String? @unique // one-session participant write credential; raw token is never stored
  participantTokenExpiresAt DateTime?
  participantConsentAt DateTime? // participant acknowledged the study notice
  participantConsentVersion String?
  withdrawnAt DateTime? // withdrawn sessions are scrubbed and locked
  scenarioId     String   // bench scenario id used as the task
  taskTimeSec    Int?
  nasaTlx        String?  // JSON: {mental, physical, temporal, performance, effort, frustration} 0-100
  susScore       Int?     // 0-100 system usability scale (groups B/C)
  notes          String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  events         StudyEvent[]
}

// Provenance stream inside a study session (what the participant actually did)
model StudyEvent {
  id        String       @id @default(cuid())
  sessionId String
  session   StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind      String       // agent_run | human_gate | export | sync | note
  detail    String       @default("")
  at        DateTime     @default(now())
}

// Immutable audit trail of every human/agent decision (I12 decision journal)
model DecisionEntry {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     String
  actor     String   @default("human") // human | agent | system
  action    String // answered_question | proceed_with_uncertainty | selected_problem | ...
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Project-scoped learning memory (I4): glossary terms + lessons never shared implicitly
model MemoryEntry {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String   @default("lesson") // glossary | lesson; scoped to one project
  term      String
  detail    String   @default("")
  createdAt DateTime @default(now())
}

// Grounding sources: interviews, documents, meeting notes…
// Supports English, Egyptian Arabic (ar-EG) and code-switched input.
model Evidence {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code       String // Stable project-scoped source id, e.g. E-AB12CD34
  title      String
  sourceType String // interview | document | meeting | survey | observation | transcript | whiteboard_ocr
  language   String   @default("en") // en | ar-EG | codeswitch
  content    String
  consent    Boolean  @default(false) // stakeholder consent recorded (G13 governance)
  origin     String   @default("human") // human | file | synthetic
  createdAt  DateTime @default(now())
  traceLinks TraceLink[]
  claims     EvidenceClaim[]
  revisions  EvidenceRevision[]
  @@unique([projectId, code])
}


// Immutable, versioned snapshots of evidence. The Evidence row remains the
// current working projection used by agents; revisions preserve provenance.
model EvidenceRevision {
  id          String   @id @default(cuid())
  evidenceId  String
  evidence    Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  version     Int
  title       String
  sourceType  String
  language    String
  content     String
  consent     Boolean
  contentHash String   // SHA-256 of canonical source fields; detects silent mutation
  changeNote  String   @default("")
  createdBy   String   @default("human") // human | system | import
  createdAt   DateTime @default(now())

  @@unique([evidenceId, version])
  @@index([evidenceId, createdAt])
  claims      EvidenceClaim[]
}


// Verbatim claims extracted from a specific immutable evidence revision.
// Offsets are JavaScript UTF-16 code-unit offsets into EvidenceRevision.content.
model EvidenceClaim {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidenceId            String
  evidence              Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  revisionId            String
  revision              EvidenceRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  claimRef              String
  claimText             String
  quote                 String
  quoteStart            Int
  quoteEnd              Int
  offsetUnit            String   @default("utf16")
  sourceRevisionVersion Int
  claimKind             String   // need | goal | constraint | preference | risk | metric | pain_point | assumption | fact
  polarity              String   @default("neutral") // affirmative | negative | neutral
  modality              String   @default("reported") // must | should | may | wants | reported | hypothetical
  speaker               String?
  extractionConfidence  Float    @default(0.5)
  status                String   @default("proposed") // proposed | in_review | accepted | rejected | needs_clarification
  extractionNote        String   @default("")
  reviewedBy            String?
  reviewedAt            DateTime?
  reviewNote            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  requirementLinks      RequirementClaim[]

  @@unique([projectId, claimRef])
  @@unique([id, projectId])
  @@unique([revisionId, quoteStart, quoteEnd, claimText])
  @@index([projectId, status, claimKind])
  @@index([evidenceId, revisionId])
  knowledgeNodes KnowledgeNodeClaim[]
  stakeholderPositionEvidence StakeholderPositionEvidence[]
}

model RequirementClaim {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement   @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  claimId       String
  claim         EvidenceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  relationship  String        @default("supports") // supports | contradicts | qualifies | derives
  note          String        @default("")
  createdAt     DateTime      @default(now())

  @@unique([requirementId, claimId])
  @@index([projectId, claimId])
}

 
// Project-scoped knowledge graph. Composite foreign keys include projectId,
// so edges and provenance links cannot accidentally cross project boundaries.
model KnowledgeNode {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeRef     String
  kind        String   // stakeholder | goal | assumption | constraint | decision | risk | metric | system | domain_concept | process | policy
  label       String
  description String   @default("")
  status      String   @default("proposed") // proposed | in_review | accepted | rejected | archived
  origin      String   @default("human") // human | agent | derived
  confidence  Float    @default(0.5)
  owner       String?
  attributes  String   @default("{}") // JSON-encoded extensible attributes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  outgoing    KnowledgeEdge[] @relation("KnowledgeEdgeFrom")
  incoming    KnowledgeEdge[] @relation("KnowledgeEdgeTo")
  claims      KnowledgeNodeClaim[]
  requirements KnowledgeRequirement[]

  @@unique([projectId, nodeRef])
  @@unique([id, projectId])
  @@index([projectId, kind, status])
  @@index([projectId, updatedAt])
}

model KnowledgeEdge {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromNodeId     String
  fromNode       KnowledgeNode @relation("KnowledgeEdgeFrom", fields: [fromNodeId, projectId], references: [id, projectId], onDelete: Cascade)
  toNodeId       String
  toNode         KnowledgeNode @relation("KnowledgeEdgeTo", fields: [toNodeId, projectId], references: [id, projectId], onDelete: Cascade)
  relationType   String       // influences | depends_on | constrains | contradicts | mitigates | implements | affects | informs | owns | part_of | derived_from | supersedes | collaborates_with
  status         String       @default("proposed") // proposed | accepted | rejected
  origin         String       @default("human") // human | agent | derived
  confidence     Float        @default(0.5)
  note           String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fromNodeId, toNodeId, relationType])
  @@index([projectId, relationType, status])
  @@index([projectId, fromNodeId])
  @@index([projectId, toNodeId])
}

model KnowledgeNodeClaim {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeId       String
  node         KnowledgeNode @relation(fields: [nodeId, projectId], references: [id, projectId], onDelete: Cascade)
  claimId      String
  claim        EvidenceClaim @relation(fields: [claimId, projectId], references: [id, projectId], onDelete: Cascade)
  relationship String        @default("supports") // supports | contradicts | qualifies | context
  note         String        @default("")
  createdAt    DateTime      @default(now())

  @@unique([nodeId, claimId])
  @@index([projectId, claimId])
}

model KnowledgeRequirement {
  id            String        @id @default(cuid())
  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodeId        String
  node          KnowledgeNode @relation(fields: [nodeId, projectId], references: [id, projectId], onDelete: Cascade)
  requirementId String
  requirement   Requirement   @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Cascade)
  role          String        @default("informs") // implements | constrains | mitigates | affects | informs | validates
  note          String        @default("")
  createdAt     DateTime      @default(now())

  @@unique([nodeId, requirementId, role])
  @@index([projectId, requirementId])
}

 
// Stakeholder registry and requirement-specific positions. Positions are
// proposals until reviewed; evidence links must point to accepted claims.
model StakeholderProfile {
  id               String   @id @default(cuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderRef   String
  displayName      String
  role             String
  organization     String   @default("")
  authorityScore   Int      @default(50)
  influenceScore   Int      @default(50)
  interestScore    Int      @default(50)
  approvalRole     String   @default("consulted") // decision_maker | approver | contributor | consulted | informed | observer
  engagementStatus String   @default("active") // active | pending | unavailable | withdrawn
  preferredLanguage String  @default("en")
  goals            String   @default("[]")
  concerns         String   @default("[]")
  notes            String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  positions        StakeholderPosition[]
  negotiationParticipants NegotiationParticipant[]

  @@unique([projectId, stakeholderRef])
  @@unique([id, projectId])
  @@index([projectId, approvalRole, engagementStatus])
}

model StakeholderPosition {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderId  String
  stakeholder    StakeholderProfile @relation(fields: [stakeholderId, projectId], references: [id, projectId], onDelete: Cascade)
  requirementId  String
  requirement    Requirement        @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Cascade)
  position       String             // supports | opposes | neutral | conditional
  confidence     Float              @default(0.5)
  rationale      String
  conditions     String             @default("")
  status         String             @default("proposed") // proposed | accepted | rejected
  capturedBy     String             @default("human")
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  evidence       StakeholderPositionEvidence[]

  @@unique([id, projectId])
  @@index([projectId, stakeholderId, requirementId])
  @@index([projectId, position, status])
}

model StakeholderPositionEvidence {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  positionId     String
  position       StakeholderPosition @relation(fields: [positionId, projectId], references: [id, projectId], onDelete: Cascade)
  claimId        String
  claim          EvidenceClaim      @relation(fields: [claimId, projectId], references: [id, projectId], onDelete: Cascade)
  relationship   String             @default("supports") // supports | contradicts | qualifies | context
  note           String             @default("")
  createdAt      DateTime           @default(now())

  @@unique([positionId, claimId])
  @@index([projectId, claimId])
}

model NegotiationDecision {
  id              String             @id @default(cuid())
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String
  requirement     Requirement        @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Cascade)
  participants    NegotiationParticipant[]
  title           String
  context         String             @default("")
  options         String             @default("[]")
  chosenOption    String?
  rationale       String             @default("")
  tradeoffs       String             @default("")
  dissent         String             @default("[]")
  status          String             @default("proposed") // proposed | approved | rejected
  decidedBy       String?
  decidedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([id, projectId])
  @@index([projectId, requirementId, status])
}

 
model NegotiationParticipant {
  id             String             @id @default(cuid())
  projectId      String
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisionId     String
  decision       NegotiationDecision @relation(fields: [decisionId, projectId], references: [id, projectId], onDelete: Cascade)
  stakeholderId  String
  stakeholder    StakeholderProfile @relation(fields: [stakeholderId, projectId], references: [id, projectId], onDelete: Cascade)
  role           String             @default("consulted") // proposer | approver | consulted | dissenting | informed
  note           String             @default("")
  responseStatus String             @default("pending") // pending | supports | opposes | conditional | abstains
  responseOptionId String?
  responseRationale String          @default("")
  respondedAt    DateTime?
  createdAt      DateTime           @default(now())

  @@unique([decisionId, stakeholderId])
  @@index([projectId, stakeholderId])
}

// Agent-generated clarifying questions, answered by the human (HITL gate 1)
model Question {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int     @default(0)
  text      String
  rationale String?
  priority  String  @default("medium") // high | medium | low
  askCost   Int? // 1..5 estimated stakeholder interruption cost (I1)
  fallbackAssumption String? // what the agent would assume if the question is skipped (I1)
  utility   String? // JSON: impact-aware planner breakdown {infoGain, impact, uncertainty, risk, askCost, utility} (dev item 7)
  answer    String?
  answered  Boolean @default(false)
  resolution String @default("pending") // pending | answered | proceed_with_uncertainty | skipped
  answerSource String @default("human") // human | synthetic | assumption | skipped
}

// Impact-aware Question Planner ablation runs (dev item 7 — the research heart)
// One row per arm execution: single_shot | random | llm | impact_aware.
// Metrics JSON: {avgUtility, utilityPerCost, evidenceCoverage, redundancyRate, dialectFit}
model PlannerRun {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  arm           String   // single_shot | random | llm | impact_aware
  experimentId      String?  // groups arms that share one immutable candidate pool
  seed              String?  // reproducible random-arm seed
  candidatePool     String?  // exact common candidate pool JSON used by this arm
  candidatePoolHash String?  // SHA-256 fingerprint shared by pool-based arms
  candidatePoolUsed Boolean? // false for the direct single-shot baseline
  questions     String   // JSON array of selected questions with per-question utility
  metrics       String?  // JSON five-metric evaluation (same judge for every arm)
  candidates    Int      @default(0) // size of the candidate pool considered
  latencyMs     Int?
  estTokens     Int?
  promptVersion String?
  createdAt     DateTime @default(now())
}

// Impact-aware problem selection (novelty contribution N2)
model ProblemCandidate {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String
  impact      Int     @default(3) // 1..5, human-tuned
  effort      Int     @default(3) // 1..5, human-tuned
  evidenceIds String  @default("") // comma-separated Evidence ids (grounding)
  selected    Boolean @default(false)
  humanEdited Boolean? // true only after an explicit human curation action
}

// Snapshot of an agent stage output (for audit / traceability)
model Artifact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     String
  kind      String   @default("json")
  content   String
  createdAt DateTime @default(now())
}

model PipelineRun {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage         String
  status        String    @default("running") // running | done | failed
  log           String?
  latencyMs     Int? // wall-clock agent latency (I13 observatory)
  estTokens     Int? // estimated total tokens (chars/4 heuristic)
  estCostUsd    Float? // estimated blended cost in USD
  promptVersion String? // prompt traceability (G6 observability)
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
}

model Requirement {
  id            String  @id @default(cuid())
  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  refId         String // REQ-01
  text          String
  type          String  @default("functional") // functional | nonfunctional | constraint
  priority      String  @default("Should") // MoSCoW: Must | Should | Could | Won't
  ambiguity     Int     @default(-1) // -1 = not yet assessed; 0..100
  ambiguityNote String?
  suggestion    String? // proposed rewrite from ambiguity agent
  confidence    Int     @default(-1) // -1 = not assessed; 0..100 agent confidence (I2 calibration)
  verifyStatus  String  @default("unverified") // supported | weak | unverified (I3 critic-verifier)
  verificationSource String @default("agent") // agent | human | unverified
  verifiedAt DateTime?
  verifiedBy String?
  verifyNote    String?
  driftStatus   String  @default("none") // none | suspected | confirmed (I8 drift radar)
  language      String  @default("en") // en | ar-EG | codeswitch
  status        String  @default("draft") // draft | revised | approved
  order         Int     @default(0)

  stories   UserStory[]
  conflictA Conflict[]  @relation("reqA")
  conflictB Conflict[]  @relation("reqB")
  links     TraceLink[]
  edgeFrom  ReqEdge[]    @relation("edgeFrom")
  edgeTo    ReqEdge[]    @relation("edgeTo")
  execScenarios ExecScenario[]
  syncMaps  SyncMap[]
  claimLinks RequirementClaim[]
  @@unique([id, projectId])
  knowledgeNodes KnowledgeRequirement[]
  qualityAssessments RequirementQualityAssessment[]
  stakeholderPositions StakeholderPosition[]
  negotiationDecisions NegotiationDecision[]
}

 
// Human-reviewable quality assessment snapshots. sourceText/sourceHash preserve
// exactly what was assessed; edits make prior assessments visibly stale.
model RequirementQualityAssessment {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String
  requirement     Requirement @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Cascade)
  sourceText      String
  sourceHash      String
  atomicity       Int
  clarity         Int
  completeness    Int
  testability     Int
  consistency     Int
  traceability    Int
  feasibility     Int
  verifiability   Int
  nfrCoverage     Int
  overallScore    Int
  issues          String      @default("[]")
  suggestedRewrite String?
  assessmentNote  String      @default("")
  status          String      @default("proposed") // proposed | accepted | rejected
  assessedBy      String      @default("human") // human | agent
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime    @default(now())

  @@index([projectId, requirementId, createdAt])
  @@index([projectId, status])
}

// Evidence traceability: which source grounds which requirement
model TraceLink {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  evidenceCode  String // stable code shown to people and in citations
  evidenceId    String?
  evidence      Evidence? @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  note          String?
}

model UserStory {
  id            String      @id @default(cuid())
  projectId     String
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  refId         String // US-01
  title         String
  narrative     String // As a <role>, I want <goal>, so that <value>
  acceptance    String // one criterion per line
  investScore   Int? // 0..100
  investNote    String?
  status        String      @default("draft") // draft | revised | approved
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  syncMaps      SyncMap[]
}

model Conflict {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reqAId      String
  reqA        Requirement @relation("reqA", fields: [reqAId], references: [id], onDelete: Cascade)
  reqBId      String
  reqB        Requirement @relation("reqB", fields: [reqBId], references: [id], onDelete: Cascade)
  kind        String      @default("contradiction") // contradiction | duplication | overlap
  taxonomy    String?     // value | terminology | scale | constraint | precedence | knowledge (dev item 10)
  description String
  severity    String      @default("medium") // high | medium | low
  suggestion  String?
  implications String?    // JSON: [{option, impact}] — presented only, never chosen by the system (dev item 10)
  resolution  String?
  status      String      @default("open") // open | resolved
}

// Typed requirement-to-requirement edges (dev item 9)
model ReqEdge {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromId    String
  from      Requirement @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        Requirement @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)
  kind      String      // depends_on | conflicts_with | derived_from | refines | validates | affected_by
  note      String?
  origin    String      @default("agent") // agent | human | derived
  createdAt DateTime    @default(now())

  @@unique([fromId, toId, kind])
}

// Executability simulation scenarios (dev item 8)
// resolution "undefined" = a requirement discovery, not a failure.
model ExecScenario {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirementId   String?
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  refId           String      // source requirement refId or GAP-nn for orphan discoveries
  given           String
  when            String
  then            String
  resolution      String      @default("defined") // defined | undefined
  undefinedReason String?
  discovery       String?     // the clarifying question / missing requirement the gap suggests
  createdAt       DateTime    @default(now())
}

// Runtime credentials for tracker integrations — server-side only,
// never returned in full to any client (masking in the API layer).
model Integration {
  id        String   @id @default(cuid())
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String   // github | jira
  config    String   // JSON: github {token, owner, repo} · jira {baseUrl, email, token, projectKey}
  createdAt DateTime @default(now())
}

// One row per externally synced work item (bidirectional trace)
model SyncMap {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind            String   // github | jira
  direction       String   // pushed | pulled | pending | creating | failed
  requirementId   String?  // local requirement pushed out
  requirement     Requirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  storyId         String?  // local story pushed out
  story           UserStory? @relation(fields: [storyId], references: [id], onDelete: SetNull)
  localLabel      String   // REQ-07 / US-03 (stable even if the local row is later deleted)
  externalKey     String   // GitHub issue number / Jira issue key
  externalUrl     String
  title           String
  syncedAt        DateTime @default(now())
  idempotencyKey  String?  @unique // stable key for best-effort duplicate recovery on tracker retries
  leaseExpiresAt  DateTime? // temporary claim while an external issue is being created
}


// Organization invitations are bearer-token workflows. Only a SHA-256 hash
// of the 256-bit random token is persisted; the raw token is shown once.
model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  invitedByUserId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  email          String
  role           String       // owner is never assignable through an invitation
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, email, acceptedAt, revokedAt])
  @@index([userId, organizationId])
  @@index([expiresAt, acceptedAt, revokedAt])
}


// Password recovery uses short-lived, single-use hashed bearer tokens.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, usedAt, revokedAt])
  @@index([expiresAt, usedAt, revokedAt])
}


// Durable idempotency ledger. Records outlive evidence deletion so a delayed
// retry cannot recreate a source after its original operation was completed.
model EvidenceOperation {
  operationId String   @id // client-generated UUID; globally unique like Evidence IDs
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action      String   // create | update | delete
  requestHash String   // SHA-256 of canonical project/action/payload semantics
  status      String   @default("processing") // processing | completed
  responseJson String? // immutable successful response snapshot for exact replay
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([status, createdAt])
}


// Organization-scoped audit events. projectId is a scalar snapshot so project
// deletion cannot cascade-delete the organization audit history.
model OrganizationAuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUserId    String?
  actor          User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  eventType      String
  resourceType   String
  resourceId     String
  projectId      String?
  summary        String       @default("")
  metadata       String       @default("{}")
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt, id])
  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, actorUserId, createdAt])
  @@index([organizationId, projectId, createdAt])
  @@index([organizationId, resourceType, resourceId])
}
