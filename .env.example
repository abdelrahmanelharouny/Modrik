# Database (SQLite for local development; PostgreSQL for serverless production)
DATABASE_URL="file:./db/custom.db"

# Single-owner access boundary (required before public deployment)
MODRIK_ADMIN_EMAIL="admin@example.com"
# Generate with: node scripts/hash-admin-password.mjs
MODRIK_ADMIN_PASSWORD_HASH=""
# Generate an independent random 32-byte value; minimum 32 bytes.
MODRIK_AUTH_SECRET=""
# Independent 32-byte base64 or 64-character hex value for AES-256-GCM.
MODRIK_ENCRYPTION_KEY=""

# Optional: exact HTTPS origins for self-hosted Jira. Atlassian Cloud tenants
# (*.atlassian.net) are allowed by default.
MODRIK_JIRA_ALLOWED_ORIGINS=""

# LLM provider configuration
RP_LLM_PROVIDER="glm"
RP_MODEL_B_BASE_URL=""
RP_MODEL_B_API_KEY=""
RP_MODEL_B_MODEL=""
RP_LOCAL_BASE_URL="http://localhost:11434/v1"
RP_LOCAL_MODEL="qwen3:8b"
RP_PLANNER_ARM="impact_aware"

# Optional deployment-level tracker fallbacks
RP_GITHUB_TOKEN=""
RP_GITHUB_OWNER=""
RP_GITHUB_REPO=""
RP_JIRA_BASE_URL=""
RP_JIRA_EMAIL=""
RP_JIRA_TOKEN=""
RP_JIRA_PROJECT_KEY=""
