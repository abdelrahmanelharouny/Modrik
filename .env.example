# Database (SQLite for local development; PostgreSQL for serverless production)
DATABASE_URL="file:./db/custom.db"

# Bootstrap owner credentials (required before protected deployment; organization RBAC is enforced separately)
MODRIK_ADMIN_EMAIL="admin@example.com"
# Generate with: node scripts/hash-admin-password.mjs
MODRIK_ADMIN_PASSWORD_HASH=""
# Generate an independent random 32-byte value; minimum 32 bytes.
MODRIK_AUTH_SECRET=""
# Independent 32-byte base64 or 64-character hex value for AES-256-GCM.
MODRIK_ENCRYPTION_KEY=""

## Shared distributed rate limiting (required in production; Upstash Redis REST).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Password recovery email (Resend). Keep unset to disable recovery.
RESEND_API_KEY=""
PASSWORD_RESET_EMAIL_FROM="Modrik <security@example.com>"
APP_URL="https://app.example.com"

# GitHub OAuth App + Atlassian OAuth 2.0 (3LO). Configure each ID/secret pair together.
# MODRIK_APP_URL must have the same HTTPS origin as APP_URL.
MODRIK_APP_URL="https://app.example.com"
MODRIK_GITHUB_CLIENT_ID=""
MODRIK_GITHUB_CLIENT_SECRET=""
MODRIK_ATLASSIAN_CLIENT_ID=""
MODRIK_ATLASSIAN_CLIENT_SECRET=""

# Run `bun run security:release-check` with the production environment before deployment.

# Optional: exact HTTPS origins for self-hosted Jira. Atlassian Cloud tenants
# (*.atlassian.net) are allowed by default.
MODRIK_JIRA_ALLOWED_ORIGINS=""

# LLM provider configuration
RP_LLM_PROVIDER="glm"
# Set true only when deployed in the native runtime that supplies z-ai-web-dev-sdk credentials.
RP_GLM_NATIVE_RUNTIME_CONFIRMED="false"
RP_MODEL_B_BASE_URL=""
RP_MODEL_B_API_KEY=""
RP_MODEL_B_MODEL=""
# Voice transcription provider: zai (default) or openai-compatible (self-hosted Whisper-compatible API)
RP_ASR_PROVIDER="zai"
RP_ASR_BASE_URL=""
RP_ASR_API_KEY=""
RP_ASR_MODEL="openai/whisper-large-v3-turbo"
RP_ASR_ALLOW_LOCAL_HTTP="false"
RP_LOCAL_BASE_URL="http://localhost:11434/v1"
RP_LOCAL_MODEL="qwen3:8b"
RP_PLANNER_ARM="impact_aware"

# Optional deployment-level tracker fallbacks
RP_GITHUB_TOKEN=""
RP_GITHUB_OWNER=""
RP_GITHUB_REPO=""
RP_JIRA_BASE_URL=""
RP_JIRA_EMAIL=""
RP_JIRA_TOKEN=""
RP_JIRA_PROJECT_KEY=""

# Organization knowledge semantic embeddings (keep reads disabled until provider + backfill are verified)
ORGANIZATION_MEMORY_EMBEDDINGS_ENABLED="false"
ORGANIZATION_MEMORY_EMBEDDING_ENDPOINT=""
ORGANIZATION_MEMORY_EMBEDDING_API_KEY=""
ORGANIZATION_MEMORY_EMBEDDING_MODEL="ibm-granite/granite-embedding-97m-multilingual-r2"
ORGANIZATION_MEMORY_EMBEDDING_DIMENSIONS="384"
# Used only when ORGANIZATION_MEMORY_EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct.
ORGANIZATION_MEMORY_EMBEDDING_QUERY_INSTRUCTION="Given a project or organization query, retrieve relevant accepted knowledge memories that answer it, including decisions, requirements, evidence, risks, owners, and prior outcomes."
ORGANIZATION_MEMORY_EMBEDDING_ALLOW_LOCAL_HTTP="false"
ORGANIZATION_MEMORY_SEMANTIC_READ_ENABLED="false"
ORGANIZATION_MEMORY_INDEXED_READ_ENABLED="false"
ORGANIZATION_MEMORY_INDEXED_SHADOW_ENABLED="false"


# Durable agent worker (run as a separate, long-lived service beside the Vercel API).
PIPELINE_WORKER_POLL_MS="1500"
PIPELINE_WORKER_CONCURRENCY="1"
PIPELINE_JOB_LEASE_MS="120000"
PIPELINE_WORKER_HEARTBEAT_MS="30000"
PIPELINE_JOB_MAX_ATTEMPTS="5"

# Optional Stripe Billing. Set every key and recurring Price ID together to activate paid plans.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_TEAM=""
STRIPE_PRICE_BUSINESS=""
STRIPE_PRICE_ENTERPRISE=""
