# Long-running agent worker. Deploy as a separate service from the Vercel web application.
FROM oven/bun:1.3.4 AS deps
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
FROM oven/bun:1.3.4 AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN bunx prisma generate --schema prisma/schema.postgres.prisma
USER bun
EXPOSE 8787
CMD ["bun","run","worker:agents"]
